;stage template by Eternaga , Email: Eternaga@hotmail.com

[Info]
name = "usa newyork blood bath'"
mugenversion = 1.0

[BGdef]
spr = xblade.sff
debugbg = 0

[Music]
bgmusic = sound\xblade.mp3
bgvolume = -100

[Camera]
startx = 0
starty = 0
boundleft = 0
boundright = 0
boundhigh = -100
boundlow = -10
verticalfollow = 1.5
floortension = 125
tension = 125
zoomin=.8
zoomout=.5

[PlayerInfo]
p1startx = -70          
p1starty = 0            
p1startz = 0            
p1facing = 1        

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 
rightbound =  1000 
topbound  =  0     
botbound  =  0     

[Scaling] 
topz     = 0       
botz     = 50      
topscale = 1       
botscale = 1.2     

[Bound]
screenleft = 15    
screenright = 15  

[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 1

[shadow]
Intensity = 90
color = 0,0,0
yscale = .2
fade.range = -400,-100

[Reflection]
intensity = 0

