[Info]
name = "The Black Order"
displayname = "The Black Order"
mugen version = 1.0
author = "Bambulin(bam77)"

[Camera]
startx = 0
starty = 0
boundleft =  -140;-64
boundright =  140;64
boundhigh = -130
boundlow = 0
verticalfollow = .8
tension = 50
floortension = 70

[PlayerInfo]
p1startx = -70
p1starty = 0
p1startz = 0
p1facing = 1

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000
rightbound =  1000
topbound  =  0
botbound  =  0

[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

[Bound]
screenleft = 20;10;15
screenright = 20;10;15

[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 0

[Shadow]
yscale = .1
color = 128,128,128

[Music]
bgmusic = sound/Theblackorder.mp3
bgvolume = 255

[BGdef]
spr =stages/Theblackorder.sff
debugbg = 0

[BG Background]
type = anim
actionno = 1
delta = .85,.8;.45, .8
mask = 1

