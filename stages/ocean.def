; [Deep Blue] Stage for Marvel Vs. Capcom - Eternity Of Heroes,Project.
; Beta Release Date: Mar 11, 2007
; Stage Composed and Scripted by TiagoFrossard: tsfrossard@gmail.com



;--------------------------------------------------------
[Info]
name = "unknown ocean floor"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = 0
boundright = 0
boundhigh = -100
boundlow = -10
verticalfollow = 1.5
floortension = 125
tension = 125
zoomin=.8
zoomout=.5


;--------------------------------------------------------
[PlayerInfo]
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 25    ;Dist from left of screen that player can move to
screenright = 25   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 210
autoturn = 1
resetBG = 0

;--------------------------------------------------------
[Shadow]
intensity = 96
color = 0,0,0
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/ocean.mp3
bgvolume = 100


;-------------------------------------
; Main background definition
[BGdef]
spr = ocean.sff
debugbg = 0


[BG 0]
type  = normal
above)
spriteno = 0, 0
layerno = 0                
start = 0, 0
delta = .3, .3
trans = none
mask  = 0
tile  = 1, 0
tilespacing = 0,0

[BG FrontArcRock]
type=normal
spriteno= 4,0
start= 0,0
mask= 1
delta= .5, .5

[BG Ground]
type = normal
spriteno = 1,0
start= 0, 0
mask=1
delta= .7, .7

;[BG 0]
;type  = normal
;above)
;spriteno = 5, 0
;layerno = 0                
;start = 0, 0
;delta = .9, .9
;trans = none
;mask  = 1
;tile  = 1, 0
;tilespacing = 0,0

[BG Ground]
type = normal
spriteno = 1,1
start= 0, 0
mask=1
delta= 1, 1


[BG Front Bubbles]
type=anim
actionno= 20
start= 0,0
mask= 1
trans = add
layerno=1
delta= 1.2, 1

