;
;------------------------------------------------------------------------------------
; Sprites by: MatreroG, Raiken, Halt77, Merku, SpriteFX, & Bonzai
; Original BGM: Fantastic Four, Flame On! - Tutorial Level (MatreroG Mix).mp3
; Date: feb/10/2019
;
; Other info: I was playing with several superheroes games for the GBA emulator. So,
; in this case, I rip the Training Level of the game Fantastic Four: Flame On!, and
; adding others sprites try to transform it into a MUGEN stage.  
; 
; Tested in MUGEN 1.1
;====================================================================================

[Info]
 ;Name of the stage.
name = "F4TrainingFacility-FantasticFour:FlameOn!(GBA)_1.1Zoom"
author = "MatreroG"
displayname = "usa newyork baxter building"

[Camera]
startx = 0
starty = 0
boundleft = -300
boundright = 300
boundhigh = -100
boundlow = -10
verticalfollow = 1.5
floortension = 125
tension = 125
zoomin=.8
zoomout=.5


[PlayerInfo]
;--- Player 1 ---
p1startx = -70      
p1starty = 0          
p1startz = 0            
p1facing = 1            

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound = -1000
rightbound = 1000 
topbound = 0 
botbound = 0 

[Scaling]
topz     = 0       
botz     = 50     
topscale = 1       
botscale = 1.2     

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset =200
autoturn = 1
resetBG = 0

[Shadow]
intensity = 70
color = 30,30,30
yscale = 0.2	
fade.range = -50, -30

[Music]
bgmusic = sound/fantasic4.mp3
bgvolume = 255

[BGdef]
spr = xf4.sff
debugbg = 0
;-------------------------------------
;back






