[Info]
name ="USA newyork Cypress Cemetery"

[Camera]
startx = 0
starty = 0
boundleft = 0
boundright = 0
boundhigh = -100
boundlow = -10
verticalfollow = 1.5
floortension = 125
tension = 125
zoomin=.8
zoomout=.55


leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound


[PlayerInfo]

p1startx = -70
p1starty = 0
p1startz = 0
p1facing = 1

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  -1000     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
 ;No need to change these values
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1.0   ;Scale to use at top
botscale = 1.4   ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 15 ;Dist from left of screen that player can move to
screenright = 15 ;Right edge
screentop = 60;

;--------------------------------------------------------
[StageInfo]
zoffset = 230
autoturn = 1
resetBG = 0

;--------------------------------------------------------
[Shadow]
color = 50,50,50
yscale = -.1
reflect = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/ghostrider.mp3
bgvolume = 255

;-------------------------------------
