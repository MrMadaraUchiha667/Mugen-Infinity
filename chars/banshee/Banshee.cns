;JUMP UP
[Statedef 50]
type    = A
physics = A

[State 50, VelSet]
type = VelSet
trigger1 = Command = "holdfwd"
trigger1 = Command != "holdback"
x = 3

[State 50, VelSet]
type = VelSet
trigger1 = Command != "holdfwd"
trigger1 = Command = "holdback"
x = -3

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = IfElse((Vel x)=0, 41, IfElse((Vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Anim = [41,43]
trigger1 = AnimTime = 0
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = S
anim = 105
ctrl = 1

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, 1]
type = VelSet
trigger1 = Time <= 12
x = Const(velocity.run.back.x)
y = 0

[State 105, 1]
type = VelSet
trigger1 = BackEdgeBodyDist <= 10
trigger2 = AnimElem = 7
x = 0

[State 105, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1



