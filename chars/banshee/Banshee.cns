[Quotes]
victory1 = "You are undertrained me boy-o!"
victory2 = "Ai, aren't you a weak one!"
victory3 = "The wail of the Banshee is too much for ye!"
victory4 = "If you think that's bad, you should hear me sing!"
victory5 = "The house of Cassidy is none to be triffled with!"
victory6 = "Try a we bit harder next time!"
victory7 = "Is that all you've got!"
victory8 = "You are no match for the Banshee of Ireland!"
victory9 = "And you call yourself a fighter!"
victory10 = "All this will be the death of me!"

; Win state decider
[Statedef 180]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 190, Stand]
type = ChangeState
trigger1 = Time = 0
trigger1 = random > 550
value = 182

[state 181, Assert]
type = assertspecial
trigger1 = Time >= 0
flag = NoBarDisplay

[State 190, Scream]
type = ChangeState
trigger1 = Time = 0
trigger1 = random <= 550
value = 181

