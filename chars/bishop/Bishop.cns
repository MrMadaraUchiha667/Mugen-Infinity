; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 183]
type = S
ctrl = 0
velset = 0,0
anim = 21

[State 184, 1]; walk
type = Changeanim
trigger1 = BackEdgeBodyDist < 190 && time = 1
value = 20

[State 184, 2]
type = velset
trigger1 = BackEdgeBodyDist < 160 
x = const(velocity.walk.fwd.x)

[State 184, 3]
type = velset
trigger1 = BackEdgeBodyDist = 160 
x = 0

[State 184, 3]
type = velset
trigger1 = BackEdgeBodyDist > 160 
x = const(velocity.walk.back.x)

[State 184, 5]; walk
type = Changestate
triggerall = time > 10
trigger1 = Vel X < 1
value = 184

