;JUMP UP
[Statedef 50]
type    = A
physics = A

[State 50, VelSet]
type = VelSet
trigger1 = Command = "holdfwd"
trigger1 = Command != "holdback"
x = 3

[State 50, VelSet]
type = VelSet
trigger1 = Command != "holdfwd"
trigger1 = Command = "holdback"
x = -3

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = IfElse((Vel x)=0, 41, IfElse((Vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Anim = [41,43]
trigger1 = AnimTime = 0
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

