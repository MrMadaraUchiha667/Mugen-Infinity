; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 10, Turn]
type = Turn
trigger1 = p2dist x < 0

[State 50, VarSet]
type = VarSet
trigger1 = time = 0
v = 54
value = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
