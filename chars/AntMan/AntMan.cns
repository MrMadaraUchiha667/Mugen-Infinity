[Data]
life = 1000 
power = 3000 
attack = 100 
defence = 100 
fall.defence_up = 50 
liedown.time = 60 
airjuggle = 20 
sparkno = 2 
guard.sparkno = 40 
KO.echo = 0 
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1 
yscale = 1
ground.back = 24 
ground.front = 25
air.back = 15 
air.front = 15 
height = 70
attack.dist = 160 
proj.attack.dist = 100 
proj.doscale = 0
head.pos = -5, -90 
mid.pos = -5, -60 
shadowoffset = 0 
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.8     
walk.back = -2.25    
run.fwd  = 6, 0      
run.back = -5, 0     
jump.neu = 0,-8.7 
jump.back = -3,-8.6   
jump.fwd = 3,-8.6   
runjump.back = -4.5,-7.25
runjump.fwd = 4.5,-7.25 
airjump.neu = 0,-7.75  
airjump.back = -4,-7.5 
airjump.fwd = 4,-7.5 

[Movement]
airjump.num = 1 
airjump.height = 40 
yaccel = .40 
stand.friction = .85 
crouch.friction = .82 

[Quotes]
victory1 = "My Antman helmet allows for communcation and influence over insects, that's the reason you are in pain"
victory2 = "I joined the avengers to help people, including the villians"
victory3 = "I've lost count of the number of times I've tried to retire from the business" 
victory4 = "You have the power to do anything, and you used it to put lives at risk"
victory5 = "Ant-Man wasn't enough, now I'm also Giant-Man. I figure if that doesn't make me tough enough, someday I'll invent another persona"

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
;Lose ( by Time over )
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
value = S175,0
volume = 0
channel = 5
freqmul = 1.0
loop = 0
pan = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
